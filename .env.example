# =========================================================
# Insight Out — 환경변수 예시
# 사용법:
#   1) 이 파일을 .env.local 로 복사
#      $ cp .env.example .env.local
#   2) 아래 빈 값들을 실제 값으로 채움
#   3) .env.local 은 절대 git commit 금지 (.gitignore 에 포함되어 있음)
# =========================================================

# ----- Supabase (필수) -----
# Supabase 프로젝트 > Project Settings > API 에서 복사
# 공개 가능한 값 (NEXT_PUBLIC_ 접두사 = 브라우저에도 노출됨)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----- Supabase 서버 전용 (관리자 리포트 업로드 필수) -----
# 절대 클라이언트에 노출 금지. .env.local 에만 두기. NEXT_PUBLIC_ 접두사 절대 금지.
# /api/admin/upload 의 서명된 업로드 URL 발급, 크롤링 결과 적재 등 서버 전용 작업에 사용.
# Supabase 대시보드 > Project Settings > API > service_role (secret) 에서 복사.
SUPABASE_SERVICE_ROLE_KEY=

# ----- 영문 콘텐츠 한국어 번역 (선택) -----
# 위에서부터 사용량 한도 내 공급자를 선택하며, 미설정 시 다음 공급자로 전환.
# 서버 전용 값이므로 NEXT_PUBLIC_ 접두사 절대 금지.
DEEPL_API_KEY=
PAPAGO_CLIENT_ID=
PAPAGO_CLIENT_SECRET=

# ----- Vercel Cron 인증 (크롤러 필수) -----
# 외부에서 /api/cron/crawl 을 직접 호출하는 것을 막는 인증 시크릿.
# Vercel 대시보드 > Settings > Environment Variables 에 동일한 값 등록 필요.
# 임의의 강력한 랜덤 문자열 사용 (예: openssl rand -hex 32)
CRON_SECRET=

# ----- 이메일 발송 — Resend (아카이빙 메일 전송 필수) -----
# 절대 클라이언트에 노출 금지. NEXT_PUBLIC_ 접두사 절대 금지.
# Resend 대시보드(resend.com) > API Keys 에서 발급.
# 무료 플랜: resend.dev 도메인으로만 발신 가능. 운영 전 커스텀 도메인 설정 필요.
# 개발 테스트: RESEND_FROM_EMAIL=onboarding@resend.dev 사용 가능.
# Vercel 배포 후 수희가 대시보드 > Settings > Environment Variables 에 추가해야 함.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# ----- 이메일 발송 — Brevo (아카이빙 메일 전송 필수) -----
# 절대 클라이언트에 노출 금지. NEXT_PUBLIC_ 접두사 절대 금지.
# Brevo 대시보드(app.brevo.com) > SMTP & API > API Keys 에서 발급.
# 발신 도메인은 Brevo > Settings > Senders, Domains & Dedicated IPs 에서 검증 필요.
# 시연용 임시: Brevo 계정 등록 이메일을 Sender로 추가·인증 후 사용 가능.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Insight Out

# ----- 앱 기본 URL (뉴스레터 수신거부 링크 등) -----
# Vercel 배포 URL. 없으면 https://insight-out-app.vercel.app 으로 폴백.
NEXT_PUBLIC_APP_URL=https://insight-out-app.vercel.app

# ----- 모닝브리핑 TTS (Google Cloud Text-to-Speech, 서버 전용) -----
# 서비스계정 JSON 키 전체를 base64 로 1줄 인코딩한 값.
#   생성: base64 -i service-account.json | tr -d '\n'   (macOS)
# 절대 클라이언트 노출·커밋 금지. Vercel 은 Production/Preview/Development 스코프 모두 설정.
GCP_TTS_SA_KEY_BASE64=
# 한국어 WaveNet 보이스 (기본 ko-KR-Wavenet-C). 미설정 시 코드 기본값 사용.
GCP_TTS_VOICE=ko-KR-Wavenet-C
# 월(KST) 글자수 상한 — WaveNet 보이스(ko-KR-Wavenet-C)의 무료 한도는 100만 자/월이다.
# (Standard 보이스는 400만 자지만 현재 기본 보이스는 WaveNet이므로 100만 기준.)
# 초과분은 100만 자당 $4 과금되므로, 무료(100만)보다 보수적으로 900000 권장. 합산 초과 시 합성 차단.
# 실사용 추정: 1회 약 1,900자 × 주5일(월 22일) ≈ 4.2만 자/월 → 무료 한도의 약 4%.
TTS_MONTHLY_CHAR_CAP=900000

# ----- 모닝브리핑 스크립트 생성 (#47) -----
# 후보 기사 게시 윈도우(시간). 미설정 시 48 (24h 는 후보가 한 자릿수로 떨어짐).
BRIEFING_WINDOW_HOURS=48
# 스크립트에 담을 최대 기사 수 (3~5건 컨셉, 기본 5)
BRIEFING_TOP_N=5
# 이 미만이면 짧은 브리핑 생성 (기본 3)
BRIEFING_MIN_ARTICLES=3
# 라디오 진행자 이름 (미설정 시 김유쁠). 바꿔도 재배포 불필요 — Vercel 값만 수정.
BRIEFING_HOST_NAME=김유쁠
# true 면 생성 직후 TTS 자동 합성 (기본 수동)
# BRIEFING_AUTO_TTS=false

# ----- LLM 키 풀 (무료 제공자, 서버 전용) -----
# provider별 콤마구분 복수 키. 실제 키는 .env.local / Vercel 환경변수에만.
# 미설정 시 해당 provider 비활성(isConfigured=false). 빌드·기존 기능 영향 없음.
GEMINI_API_KEYS=
GROQ_API_KEYS=
OPENROUTER_API_KEYS=
CEREBRAS_API_KEYS=
SAMBANOVA_API_KEYS=
MISTRAL_API_KEYS=
# 모델 override (미지정 시 코드 기본값 사용. 무료 모델 ID 변동 시 여기서 수정)
GEMINI_MODEL=
GROQ_MODEL=
OPENROUTER_MODEL=
CEREBRAS_MODEL=
SAMBANOVA_MODEL=
MISTRAL_MODEL=
