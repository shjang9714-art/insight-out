# =========================================================
# Insight Out — 환경변수 예시
# 사용법:
#   1) 이 파일을 .env.local 로 복사
#      $ cp .env.example .env.local
#   2) 아래 빈 값들을 실제 값으로 채움
#   3) .env.local 은 절대 git commit 금지 (.gitignore 에 포함되어 있음)
# =========================================================

# ----- Supabase (필수) -----
# Supabase 프로젝트 > Project Settings > API 에서 복사
# 공개 가능한 값 (NEXT_PUBLIC_ 접두사 = 브라우저에도 노출됨)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----- Supabase 서버 전용 (선택, 관리자 기능 추가 시 필요) -----
# 절대 클라이언트에 노출 금지. .env.local 에만 두기.
# 현재 코드에는 사용처가 없지만, RLS 우회가 필요한 서버 작업(어드민 일괄 작업,
# 크롤링 결과 적재 등)을 추가할 때 사용. 미리 받아둘 필요는 없음.
# SUPABASE_SERVICE_ROLE_KEY=

# ----- (참고) 추가될 가능성이 있는 변수 -----
# Phase 2 에서 LLM API, Phase 3 에서 이메일 발송 추가 시 여기에 키 이름을 적어두기
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GEMINI_API_KEY=
# UPSTAGE_API_KEY=
# COHERE_API_KEY=
# RESEND_API_KEY=
