-- 313 LG U+ 관점 시사점 — contents.lgu_implication (서술문)
-- 핸드오프: 수희 → Supabase SQL Editor. **에디터를 완전히 비우고**(Cmd+A → Delete) 붙여넣고 RUN. 멱등.
-- 전제: 241(lgu_impact 컬럼) 적용됨.
--
-- 배경:
--   lgu_impact('위기'|'기회'|'관망') 라벨은 241에서 이미 만들었지만,
--   **서술문이 없고 사용자 화면에 한 번도 노출된 적이 없다**(경쟁사 주간 생성 프롬프트 입력으로만 사용).
--
--   313은 요약 LLM 호출에 시사점을 얹어 한 번에 생성한다.
--   (별도 호출로 만들면 토큰 2배 — 본문을 두 번 넣게 된다)
--
--   ⛔ null 이 정상이다. 대부분의 기사는 LG U+ 와 직접 관련이 없다.
--      억지 시사점은 없느니만 못하다.

begin;

alter table public.contents
  add column if not exists lgu_implication text;

comment on column public.contents.lgu_implication is
  'LG U+ 관점의 시사점 1~2문장(313). null = 관련 없음(정상). lgu_impact(241) 라벨과 한 쌍.';

commit;

-- ── 확인용 ───────────────────────────────────────────────────────────────────
-- 컬럼이 생겼는지:
