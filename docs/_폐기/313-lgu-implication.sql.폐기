--     from information_schema.columns
--    where table_schema = 'public' and table_name = 'contents'
--      and column_name in ('lgu_impact', 'lgu_implication');
--
-- 313 배포 + 요약 백필 후 — 시사점이 붙는 비율(너무 높으면 억지 시사점을 만들고 있다는 뜻):
--   select
--     count(*)                                          as 요약있음,
--     count(*) filter (where lgu_implication is not null) as 시사점있음,
--     round(100.0 * count(*) filter (where lgu_implication is not null) / nullif(count(*),0), 1) as 비율,
--     count(*) filter (where lgu_impact = '위기')        as 위기,
--     count(*) filter (where lgu_impact = '기회')        as 기회,
--     count(*) filter (where lgu_impact = '관망')        as 관망
--   from public.contents
--   where summary_ko is not null
--     and collected_at > now() - interval '7 days';
--
--   → 비율이 80%를 넘으면 프롬프트가 억지로 만들고 있는 것이다. 대부분은 null 이어야 정상.
